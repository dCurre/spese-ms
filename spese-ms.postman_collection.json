{
  "info": {
    "name": "spese-ms",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:5000",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "API Health Check",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/",
              "host": ["{{base_url}}"],
              "path": ["api", ""]
            }
          }
        }
      ]
    },
    {
      "name": "Users",
      "item": [
        {
          "name": "Get all users",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/users",
              "host": ["{{base_url}}"],
              "path": ["api", "users"]
            }
          }
        }
      ]
    },
    {
      "name": "Expenses",
      "item": [
        {
          "name": "Get all expenses",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/expenses",
              "host": ["{{base_url}}"],
              "path": ["api", "expenses"]
            }
          }
        }
      ]
    },
    {
      "name": "Expenses Lists",
      "item": [
        {
          "name": "Get all expenses lists",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/expenses-lists",
              "host": ["{{base_url}}"],
              "path": ["api", "expenses-lists"]
            }
          }
        }
      ]
    }
  ]
}
